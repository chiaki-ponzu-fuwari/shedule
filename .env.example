# --- Supabase（グループ同期など）---
# ダッシュボード → Project Settings → API
# 公開してよいのは anon（publishable）キーのみ。service_role はクライアントに置かないこと。
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# 設定画面・App Store Connectで使う法務/サポートサイトの公開HTTPS URL
EXPO_PUBLIC_LEGAL_BASE_URL=https://YOUR_LEGAL_SITE_DOMAIN
#
# 認証・RLS: Dashboard → Authentication → Providers で「Anonymous」を有効にする。
# SQL はリポジトリの supabase/migrations を 000 → 009 の番号順に実行する。
# 005 は個人バックアップ、006 は安全な統合・削除、007 は通報・ブロック、
# 008 はApple資格失効、009 は招待コード保護です。
# Dashboardでは「Allow manual linking」も有効にする。詳細は DEPLOY_CHECKLIST.md を参照。

# Google Calendar連携用 OAuth クライアントID
# Google Cloud Console ( https://console.cloud.google.com/ ) で取得
# → APIとサービス → 認証情報 → OAuthクライアントID

# iOS用クライアントID（アプリの種類: iOS）
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID_HERE

# Web用クライアントID（ローカル開発・Chrome確認用。アプリの種類: ウェブアプリケーション）
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID_HERE
#
# Google Cloud → 「承認済みのリダイレクト URI」に登録する例（Web クライアント用）
# （hooks/useGoogleAuth.web.ts は path: 'auth' のため、末尾は /auth）
#   http://localhost:8081/auth
#   http://localhost:19006/auth
#   （実際のポートは npx expo start --web 起動後のブラウザ URL に合わせる）
#   本番: https://あなたのドメイン/auth
# アプリの scheme（ディープリンク）: app.json の "scheme" → このプロジェクトは recoto
#
# --- セキュリティ（第三者対策のチェックリスト）---
# - Google: 上記 URI を本番・開発用に最小限だけ登録。クライアントシークレットは .env に書かない。
# - Supabase: RLS を本番 DB にも適用する（DEPLOY_CHECKLIST.md の ①）。anon キーだけではデータは守られない。
# - トークンやエラー詳細を console / サポート用スクショに載せない（本番ビルドでは診断ログは出ない）。
