# Local Edge Function development only. Never commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Comma-separated exact web origins. Native requests do not send Origin.
ALLOWED_WEB_ORIGINS=http://localhost:8081,https://YOUR_APP_DOMAIN.example

# Comma-separated OAuth client IDs accepted when validating Google provider tokens.
GOOGLE_OAUTH_CLIENT_IDS=YOUR_GOOGLE_WEB_CLIENT_ID

# Native Sign in with Apple credential exchange/revocation.
# For the iOS native flow, APPLE_CLIENT_ID is the app bundle identifier.
APPLE_CLIENT_ID=com.herac.recoto
# Bundle IDs and Services IDs accepted as Apple notification audiences.
APPLE_NOTIFICATION_CLIENT_IDS=com.herac.recoto
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_P8_KEY\n-----END PRIVATE KEY-----

# Generate 32 random bytes per key and encode each as base64. Keep every key
# referenced by an existing credential until that credential has been revoked.
APPLE_TOKEN_ENCRYPTION_KEYS_JSON={"apple-token-key-v1":"YOUR_32_BYTE_BASE64_KEY"}
APPLE_TOKEN_ENCRYPTION_KEY_ID=apple-token-key-v1
